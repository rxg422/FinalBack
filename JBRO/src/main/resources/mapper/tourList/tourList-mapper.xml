<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="tourListMapper">

    <!-- RESULT MAP -->
    <resultMap id="tourListResultMap"
               type="com.jbro.tourList.model.vo.TourList">

        <id property="tourPlaceId"
            column="TOUR_PLACE_ID"/>

        <result property="contentId"
                column="CONTENT_ID"/>

        <result property="contentTypeId"
                column="CONTENT_TYPE_ID"/>

        <result property="title"
                column="TITLE"/>

        <result property="firstImage"
                column="FIRST_IMAGE"/>

        <result property="firstImage2"
                column="FIRST_IMAGE2"/>

        <result property="areaCode"
                column="AREA_CODE"/>

        <result property="regionName"
                column="REGION_NAME"/>

        <result property="addr1"
                column="ADDR1"/>

        <result property="addr2"
                column="ADDR2"/>

        <result property="mapX"
                column="MAP_X"/>

        <result property="mapY"
                column="MAP_Y"/>

        <result property="viewCount"
                column="VIEW_COUNT"/>

        <result property="createdAt"
                column="CREATED_AT"/>

        <result property="favoriteCount"
                column="FAVORITE_COUNT"/>

        <result property="likedYn"
                column="LIKED_YN"/>

        <result property="reviewCount"
                column="REVIEW_COUNT"/>

        <result property="categoryName"
                column="CATEGORY_NAME"/>

    </resultMap>


    <!-- 공통 FROM -->
    <sql id="tourListBaseQuery">

    FROM TOUR_PLACE TP

    JOIN CATEGORY C
      ON TP.CATEGORY_ID = C.ID

    LEFT JOIN (
        SELECT
            CONTENT_ID,
            COUNT(*) AS FAVORITE_COUNT
        FROM FAVORITE
        GROUP BY CONTENT_ID
    ) F
    ON TP.CONTENT_ID = F.CONTENT_ID

    LEFT JOIN FAVORITE MYF
      ON TP.CONTENT_ID = MYF.CONTENT_ID
     AND MYF.USER_ID = #{userId}

    LEFT JOIN (
        SELECT
            CONTENT_ID,
            COUNT(*) AS REVIEW_COUNT
        FROM REVIEW
        WHERE REVIEW_ACTIVE = 'Y'
        GROUP BY CONTENT_ID
    ) RV
    ON TP.CONTENT_ID = RV.CONTENT_ID

    WHERE 1 = 1

    <if test="categoryId != null">
        AND TP.CATEGORY_ID = #{categoryId}
    </if>

    <if test="keyword != null and keyword != ''">
        AND TP.TITLE LIKE '%' || #{keyword} || '%'
    </if>

</sql>


    <!-- 목록 조회 -->
    <select id="selectTourList"
            resultMap="tourListResultMap">

        SELECT *
        FROM (

            SELECT
                A.*,
                ROWNUM RN

            FROM (

                SELECT

                    TP.TOUR_PLACE_ID,
                    TP.CONTENT_ID,
                    TP.CONTENT_TYPE_ID,

                    TP.TITLE,

                    TP.FIRST_IMAGE,
                    TP.FIRST_IMAGE2,

                    TP.AREA_CODE,
                    R.REGION_NAME,

                    TP.ADDR1,
                    TP.ADDR2,

                    TP.MAP_X,
                    TP.MAP_Y,

                    TP.VIEW_COUNT,

                    TP.CREATED_AT,

                    NVL(F.FAVORITE_COUNT, 0)
                    AS FAVORITE_COUNT,

                    NVL(RV.REVIEW_COUNT, 0)
                    AS REVIEW_COUNT,

                    CASE
                        WHEN MYF.USER_ID IS NOT NULL
                        THEN 'Y'
                        ELSE 'N'
                    END AS LIKED_YN,

                    CASE
                        WHEN TP.CONTENT_TYPE_ID = '12'
                        THEN '관광지'

                        WHEN TP.CONTENT_TYPE_ID = '32'
                        THEN '숙소'

                        WHEN TP.CONTENT_TYPE_ID = '39'
                        THEN '음식점'

                        WHEN TP.CONTENT_TYPE_ID = '15'
                        THEN '축제'

                        ELSE '기타'
                    END AS CATEGORY_NAME

                <include refid="tourListBaseQuery"/>

                <!-- 정렬 -->
                <choose>

                    <when test="sort == 'popular'">
                        ORDER BY TP.VIEW_COUNT DESC
                    </when>

                    <when test="sort == 'latest'">
                        ORDER BY TP.CREATED_AT DESC
                    </when>

                    <otherwise>
                        ORDER BY TP.TOUR_PLACE_ID DESC
                    </otherwise>

                </choose>

            ) A

            WHERE ROWNUM <![CDATA[ <= ]]> #{offset} + #{limit}

        )

        WHERE RN <![CDATA[ > ]]> #{offset}

    </select>


    <!-- 전체 개수 -->
    <select id="selectTourListCount"
            resultType="int">

        SELECT COUNT(*)

        <include refid="tourListBaseQuery"/>

    </select>

	<select id="selectFavoriteCount" resultType="int">
    SELECT COUNT(*)
    FROM FAVORITE
    WHERE USER_ID = #{userId}
      AND CONTENT_ID = #{contentId}
</select>

<insert id="insertFavorite">
    INSERT INTO FAVORITE (
        USER_ID,
        CONTENT_ID
    )
    VALUES (
        #{userId},
        #{contentId}
    )
</insert>

<delete id="deleteFavorite">
    DELETE FROM FAVORITE
    WHERE USER_ID = #{userId}
      AND CONTENT_ID = #{contentId}
</delete>
</mapper>